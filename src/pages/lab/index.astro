---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale } from '../../utils/i18n';

const currentLocale: Locale = (Astro.currentLocale as Locale) || 'en';
---

<BaseLayout title="Lab - Rayko Azcue" locale={currentLocale}>
  <div class="min-h-screen bg-bg flex items-center justify-center px-6">
    <!-- Main Content -->
    <main class="text-center max-w-2xl">
      <h1 class="text-4xl lg:text-6xl font-bold text-text mb-8">Coming Soon</h1>
      <p class="text-xl text-text-secondary">
        Experiments and micro-solutions. Exploring cool stuff and having fun.
      </p>
    </main>
  </div>
</BaseLayout>
