---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedPost from '../../components/blog/FeaturedPost';
import BlogCard from '../../components/blog/BlogCard';
import NewsletterSignup from '../../components/blog/NewsletterSignup';
import TagFilter from '../../components/blog/TagFilter';
import SortControl from '../../components/blog/SortControl';
import { getTranslation } from '../../utils/i18n';

const t = getTranslation('en');

// Get all English blog posts
const allPosts = await getCollection('blog', ({ data }) => {
  return data.locale === 'en' && !data.draft;
});

// Get the selected tag, sort type, and sort direction from URL params
const url = new URL(Astro.request.url);
const selectedTag = url.searchParams.get('tag');
const sortBy = url.searchParams.get('sort') || 'date';
const sortDirection =
  url.searchParams.get('dir') || (sortBy === 'readingTime' ? 'asc' : 'desc');

// Sort posts based on selected criteria and direction
let sortedPosts = [...allPosts];

if (sortBy === 'readingTime') {
  sortedPosts.sort((a, b) => {
    return sortDirection === 'asc'
      ? a.data.readingTime - b.data.readingTime
      : b.data.readingTime - a.data.readingTime;
  });
} else {
  // Default: sort by date
  sortedPosts.sort((a, b) => {
    return sortDirection === 'asc'
      ? a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
      : b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  });
}

// Filter posts by tag if a tag is selected
const filteredPosts = selectedTag
  ? sortedPosts.filter((post) => post.data.tags.includes(selectedTag))
  : sortedPosts;

// Get featured post (only from filtered posts if tag is selected)
const featuredPost = selectedTag
  ? null
  : sortedPosts.find((post) => post.data.featured);

// Get all posts for the grid (including featured if no tag selected)
const regularPosts = filteredPosts;

// Get all unique tags
const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();

const seo = {
  title: 'Blog - Rayko Azcue',
  description:
    'Technical articles about web development, performance, and modern frameworks',
  keywords: 'web development, astro, react, performance, blog',
  locale: 'en' as const,
};
---

<BaseLayout {...seo}>
  <!-- Main Content -->
  <main class="flex-1 overflow-y-auto">
    <div class="container mx-auto pl-4 lg:pl-6 py-12 max-w-6xl">
      <!-- Header -->
      <div class="mb-12">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h1 class="text-4xl md:text-5xl font-bold text-text mb-4">
              {t.blog.title}
            </h1>
            <p class="text-lg text-text-secondary">
              {t.blog.subtitle}
            </p>
          </div>
          <a
            href="/rss.xml"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-4 py-2 bg-surface text-text-secondary hover:text-accent border border-surface rounded-lg transition-colors text-sm font-medium"
            title="Subscribe to RSS feed"
          >
            <div class="i-tabler-rss w-4 h-4"></div>
            RSS
          </a>
        </div>
      </div>
      <!-- Featured Post + Newsletter -->
      {
        featuredPost && (
          <div class="mb-16">
            <FeaturedPost post={featuredPost} client:load />
            <div class="mt-8">
              <NewsletterSignup locale="en" client:load />
            </div>
          </div>
        )
      }

      <!-- Tags Filter -->
      <TagFilter
        tags={allTags}
        locale="en"
        currentTag={selectedTag}
        currentSort={sortBy}
        currentDir={sortDirection}
        client:load
      />

      <!-- Sort Control -->
      <SortControl locale="en" client:load />

      <!-- Blog Posts Grid -->
      <div class="grid md:grid-cols-2 gap-6">
        {
          regularPosts.map((post) => (
            <BlogCard post={post} view="grid" client:load />
          ))
        }
      </div>

      {
        regularPosts.length === 0 && !featuredPost && (
          <div class="text-center py-16">
            <p class="text-text-secondary text-lg">
              No posts yet. Check back soon!
            </p>
          </div>
        )
      }
    </div>
  </main>
</BaseLayout>
