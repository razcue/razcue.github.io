---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { type Locale } from '../../../utils/i18n';

const currentLocale: Locale = 'es';
---

<BaseLayout title="Laboratorio - Rayko Azcue" locale={currentLocale}>
  <div class="min-h-[100dvh] bg-bg flex items-center justify-center px-6">
    <!-- Main Content -->
    <main class="text-center max-w-2xl">
      <h1 class="text-4xl lg:text-6xl font-bold text-text mb-8">
        Próximamente
      </h1>
      <p class="text-xl text-text-secondary">
        Experimentos y micro-soluciones. Explorando cosas interesantes y
        divirtiéndome.
      </p>
    </main>
  </div>
</BaseLayout>
