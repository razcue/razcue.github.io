---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.tsx';
import Navigation from '../components/Navigation.tsx';
import About from '../components/About.tsx';
import JobStatus from '../components/JobStatus.tsx';
import Experience from '../components/Experience.tsx';
import Projects from '../components/Projects.tsx';
import Contact from '../components/Contact.tsx';
import Footer from '../components/Footer.tsx';
import { type Locale } from '../utils/i18n';

const currentLocale: Locale = (Astro.currentLocale as Locale) || 'en';
---

<BaseLayout locale={currentLocale} showNavigation={true}>
  <!-- Locale preference redirect script -->
  <script>
    // Check if user has a stored locale preference and redirect if needed
    const storedLocale = localStorage.getItem('locale');
    const currentPath = window.location.pathname;

    // Only redirect on first load of the English homepage
    if (storedLocale === 'es' && currentPath === '/') {
      window.location.href = '/es/';
    }
  </script>

  <div id="portfolio-layout" class="min-h-screen flex overflow-x-hidden">
    <!-- Column 1: Hero & Navigation (No scroll) - Max width 640px -->
    <div
      class="hidden lg:flex flex-col pt-0 py-8 justify-between overflow-y-hidden bg-bg w-full max-w-md min-w-80"
    >
      <div class="p-6 lg:p-8 space-y-6 md:space-y-8">
        <!-- Hero Section with Social Links -->
        <Hero locale={currentLocale} client:idle />

        <!-- Navigation -->
        <Navigation locale={currentLocale} client:idle />
      </div>

      <!-- Footer -->
      <Footer locale={currentLocale} />
    </div>

    <!-- Column 2: Main Content - Flexible width -->
    <div class="flex-1 bg-bg min-w-0" id="main-content">
      <div
        id="main-scroll"
        class="h-screen overflow-y-auto m-y-auto md:pt-0 pb-20 md:pb-0 pl-2 lg:pl-0"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        <div class="max-w-full lg:max-w-6xl mx-auto">
          <About locale={currentLocale} />
          <JobStatus locale={currentLocale} client:visible />
          <Experience locale={currentLocale} client:visible />
          <Projects locale={currentLocale} client:visible />
          <!-- <ThisSite locale={currentLocale} client:visible /> -->
          <Contact locale={currentLocale} client:visible />
        </div>
      </div>
    </div>
  </div>

  <div
    class="lg:hidden fixed bottom-0 left-0 right-0 py-2 sm:py-4 w-full flex justify-center bg-bg z-10"
  >
    <Footer locale={currentLocale} />
  </div>

  <style>
    #main-content #main-scroll {
      scroll-behavior: smooth;
    }
  </style>

  <script>
    // Section snapping: wheel/keyboard for desktop, native touch scroll-snap for mobile
    document.addEventListener('DOMContentLoaded', () => {
      const container = document.querySelector(
        '#main-content #main-scroll'
      ) as HTMLElement;
      if (!container) return;

      const sections = Array.from(
        container.querySelectorAll('section')
      ) as HTMLElement[];
      if (!sections.length) return;

      // Scroll to section based on URL hash on page load
      const hash = window.location.hash.replace('#', '');
      if (hash) {
        const targetSection = document.getElementById(hash);
        if (targetSection) {
          setTimeout(() => {
            targetSection.scrollIntoView({ behavior: 'smooth' });
          }, 100);
        }
      }

      let isAnimating = false;
      const animationTimeout = 800;

      // Get current section based on scroll position
      const getCurrentIndex = () => {
        const scrollTop = container.scrollTop;
        let nearest = 0;
        let minDiff = Infinity;
        for (let i = 0; i < sections.length; i++) {
          const offset = sections[i].offsetTop;
          const diff = Math.abs(offset - scrollTop);
          if (diff < minDiff) {
            minDiff = diff;
            nearest = i;
          }
        }
        return nearest;
      };

      // Scroll to section using scrollIntoView (same as Sidebar navigation)
      const scrollToIndex = (index: number) => {
        const clamped = Math.max(0, Math.min(sections.length - 1, index));
        const section = sections[clamped];
        if (!section) return;

        isAnimating = true;
        section.scrollIntoView({ behavior: 'smooth' });
        setTimeout(() => {
          isAnimating = false;
        }, animationTimeout);
      };

      // Check if interacting with form elements
      const isInteractive = (el: EventTarget | null) => {
        if (!(el instanceof Element)) return false;
        const tag = el.tagName.toLowerCase();
        return ['input', 'textarea', 'select', 'button'].includes(tag);
      };

      // Wheel handling for desktop (one section at a time)
      const onWheel = (e: WheelEvent) => {
        // Skip if chat is open - let chat handle its own scroll
        if (document.body.classList.contains('chat-open')) return;

        if (isAnimating) {
          e.preventDefault();
          return;
        }
        if (isInteractive(e.target)) return;

        const delta = e.deltaY;
        if (Math.abs(delta) < 10) return;

        e.preventDefault();
        const idx = getCurrentIndex();
        if (delta > 0) scrollToIndex(idx + 1);
        else scrollToIndex(idx - 1);
      };

      window.addEventListener('wheel', onWheel, { passive: false });
      container.addEventListener('wheel', onWheel, { passive: false });

      // Keyboard navigation
      window.addEventListener('keydown', (e) => {
        // Skip if chat is open
        if (document.body.classList.contains('chat-open')) return;

        const active = document.activeElement;
        if (
          active &&
          ['input', 'textarea', 'select'].includes(active.tagName.toLowerCase())
        )
          return;
        if (isAnimating) {
          e.preventDefault();
          return;
        }

        const idx = getCurrentIndex();
        if (e.key === 'ArrowDown' || e.key === 'PageDown') {
          e.preventDefault();
          scrollToIndex(idx + 1);
        } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
          e.preventDefault();
          scrollToIndex(idx - 1);
        } else if (e.key === 'Home') {
          e.preventDefault();
          scrollToIndex(0);
        } else if (e.key === 'End') {
          e.preventDefault();
          scrollToIndex(sections.length - 1);
        }
      });

      // Touch navigation for mobile
      let touchStartY = 0;
      let touchStartTime = 0;

      container.addEventListener(
        'touchstart',
        (e) => {
          if (isInteractive(e.target)) return;
          touchStartY = e.touches[0].clientY;
          touchStartTime = Date.now();
        },
        { passive: true }
      );

      container.addEventListener(
        'touchmove',
        (e) => {
          if (isInteractive(e.target)) return;
          // Prevent default scroll during swipe
          e.preventDefault();
        },
        { passive: false }
      );

      container.addEventListener(
        'touchend',
        (e) => {
          if (isAnimating) return;
          if (isInteractive(e.target)) return;

          const touchEndY = e.changedTouches[0].clientY;
          const touchEndTime = Date.now();
          const diff = touchStartY - touchEndY;
          const duration = touchEndTime - touchStartTime;

          // Minimum swipe distance (50px) and max duration (500ms for swipe)
          if (Math.abs(diff) < 50 || duration > 500) return;

          const idx = getCurrentIndex();
          if (diff > 0) {
            // Swiped up (bottom to top) - go to next section
            scrollToIndex(idx + 1);
          } else {
            // Swiped down (top to bottom) - go to previous section
            scrollToIndex(idx - 1);
          }
        },
        { passive: true }
      );
    });
  </script>
</BaseLayout>
