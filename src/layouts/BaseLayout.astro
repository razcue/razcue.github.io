---
import '../styles/global.css';
import { getTranslation, type Locale } from '../utils/i18n';
import Sidebar from '../components/Sidebar';

export interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  showNavigation?: boolean;
}

const {
  title,
  description,
  locale = 'en',
  showNavigation = false,
} = Astro.props;
const t = getTranslation(locale);

// Use i18n SEO content
const finalTitle = title || t.seo.title;
const finalDescription = description || t.seo.description;

// Canonical URL with proper locale
const baseUrl = 'https://razcue.github.io';
const canonicalPath = locale === 'es' ? '/es/' : '/';
const canonicalUrl = `${baseUrl}${canonicalPath}`;

// Alternate language URLs
const enUrl = baseUrl + '/';
const esUrl = baseUrl + '/es/';

// Try og-image.jpg first, fallback to svg (create a proper JPG for production)
const ogImage = `${baseUrl}/og-image.svg`;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{finalTitle}</title>
    <meta name="title" content={finalTitle} />
    <meta name="description" content={finalDescription} />
    <meta name="author" content="Rayko Azcue" />
    <meta name="keywords" content={t.seo.keywords} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0a192f" />
    <meta name="googlebot" content="index, follow" />
    <meta
      name="google-site-verification"
      content="TVVS4E_zJ3cyJDwUq1adRtCOZySQUpV-PqN4swPjP7s"
    />

    <!-- Canonical and Alternate URLs -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.seo.ogImageAlt} />
    <meta property="og:site_name" content={t.seo.siteName} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta
      property="og:locale:alternate"
      content={locale === 'es' ? 'en_US' : 'es_ES'}
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Rayko Azcue - Frontend Developer" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Resource Hints for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />

    <meta name="generator" content={Astro.generator} />

    <!-- Structured Data - JSON-LD for Person and Website -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Person',
            '@id': `${baseUrl}/#person`,
            name: 'Rayko Azcue',
            url: baseUrl,
            image: ogImage,
            jobTitle: t.seo.jobTitle,
            description: finalDescription,
            sameAs: [
              'https://github.com/razcue',
            ],
            knowsAbout: [
              'Vue.js',
              'Nuxt',
              'React',
              'Astro',
              'TypeScript',
              'JavaScript',
              'Tailwind CSS',
              'UnoCSS',
              'Node.js',
              'PHP',
              'Laravel',
              'Web Development',
              'Frontend Development',
              'Responsive Design',
            ],
            knowsLanguage: [
              { '@type': 'Language', name: 'English' },
              { '@type': 'Language', name: 'Spanish' },
            ],
          },
          {
            '@type': 'WebSite',
            '@id': `${baseUrl}/#website`,
            url: baseUrl,
            name: t.seo.siteName,
            description: finalDescription,
            inLanguage: [locale === 'es' ? 'es-ES' : 'en-US'],
            author: {
              '@id': `${baseUrl}/#person`,
            },
          },
          {
            '@type': 'WebPage',
            '@id': `${canonicalUrl}#webpage`,
            url: canonicalUrl,
            name: finalTitle,
            description: finalDescription,
            inLanguage: locale === 'es' ? 'es-ES' : 'en-US',
            isPartOf: {
              '@id': `${baseUrl}/#website`,
            },
            about: {
              '@id': `${baseUrl}/#person`,
            },
          },
        ],
      })}
    />
  </head>
    <body class="bg-bg text-text font-sans antialiased">
      <!-- Skip to main content link for accessibility -->
      <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-accent text-surface px-4 py-2 rounded-lg z-50"
      >
        Skip to main content
      </a>

      <div class="flex min-h-[100dvh]">
        <!-- Main Content Area - Add right padding to prevent overlap with fixed sidebar -->
        <div class="flex-1 min-w-0 pr-12 lg:pr-20">
          <slot />
        </div>

        <!-- Sidebar - Fixed position -->
        <div class="fixed right-0 top-0 h-screen bg-bg px-1 lg:px-4 flex flex-col items-center w-12 lg:w-20 z-50">
          <Sidebar
            locale={locale}
            showNavigation={showNavigation}
            currentPath={Astro.url.pathname}
            client:load
          />
        </div>
      </div>
    </body>
</html>
