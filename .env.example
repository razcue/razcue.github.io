# API URL for contact form (Vercel serverless function)
# Update this with your actual Vercel project URL after deploying the API
PUBLIC_API_URL=https://your-vercel-project.vercel.app/api/contact

# Resend API Configuration (for Vercel API)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Buttondown Newsletter API
# Get your API key from https://buttondown.email/settings
BUTTONDOWN_API_KEY=your_buttondown_api_key_here

# Vercel Configuration (for GitHub Actions)
VERCEL_TOKEN=your_token_key_here
VERCEL_ORG_ID=team_your_org_id_here
VERCEL_PROJECT_ID=prj_your_project_id_here