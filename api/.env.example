# Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Groq API Key for AI Chat
# Get free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Buttondown API Configuration
# Get your API key from https://buttondown.email/settings/programming
BUTTONDOWN_API_KEY=your_buttondown_api_key_here

# Yandex SMTP Configuration (for send-email API)
# Generate app password at https://id.yandex.com/security/app-passwords (select "Mail")
YANDEX_USER=razcue
YANDEX_APP_PASSWORD=xxxx xxxx xxxx xxxx
YANDEX_SMTP_HOST=smtp.yandex.com
YANDEX_SMTP_PORT=465
SENDER_NAME=Rayko Azcue Pérez
SENDER_EMAIL=razcue@yandex.com

# API Key for send-email endpoint (optional but recommended for production)
SEND_EMAIL_API_KEY=your-secret-api-key
